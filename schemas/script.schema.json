{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manga-to-video/script.schema.json",
  "title": "Script kịch bản cả chương (rút gọn từ content-extractor/lib/schema.ts:188-196 — shots full-slice, region null, motion auto)",
  "type": "object",
  "required": ["version", "segments"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "order", "narration", "shot_indices"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^seg-[0-9]{3}$",
            "description": "seg-NNN theo order (seg-000, seg-001, ...)"
          },
          "order": { "type": "integer", "minimum": 0 },
          "narration": {
            "type": "string",
            "minLength": 1,
            "description": "Lời kể ngôi ba — không được rỗng (kiểm tra trim ở business rules)"
          },
          "shot_indices": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0 },
            "description": "Index slice mà đoạn kể phủ, theo thứ tự đọc"
          }
        }
      }
    }
  }
}
